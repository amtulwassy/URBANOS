# Copy this file to ".env" in the same folder and fill in real values.

ENV=development
DEBUG=true

# ---- PostgreSQL / PostGIS ----
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://urbanos_user:urbanos_pass@localhost:5432/urbanos_db

# ---- JWT ----
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- CORS: origins allowed to call this API from the browser ----
# Add whatever origin/port you use to serve the frontend (Live Server, http.server, etc.)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,null

# ---- Data mode ----
# demo -> zero external dependencies, safe synthetic weather + demo-labelled data
# live -> calls WEATHER_API_BASE_URL using WEATHER_API_KEY
DATA_MODE=demo

# ---- Weather API (only needed when DATA_MODE=live) ----
WEATHER_API_KEY=your_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ---- Risk engine thresholds (0-100 score -> level) ----
RISK_THRESHOLD_MODERATE=30
RISK_THRESHOLD_HIGH=55
RISK_THRESHOLD_CRITICAL=75

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
